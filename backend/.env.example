# 珞珈BBS 后端环境变量示例
# 复制为 .env 或直接在部署环境 export；环境变量优先级高于 config.yaml。
#
# 命名规则：配置键 database.password -> DATABASE_PASSWORD（点转下划线、全大写）。
# config.yaml 中无需填写真实密钥，留空即可，由本文件注入。

# ---- 数据库 ----
DATABASE_PASSWORD=change-me

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO（对象存储） ----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
# 图片公开访问域名前缀（不含末尾 /），用于前端直接预览图片。
# 需申请一个公网域名指向 MinIO 的 public-images 桶，形如 https://img.jianjiange.site/public-images
# （待域名申请下来后填真实值）
MINIO_PUBLIC_BASE_URL=https://img.jianjiange.site/public-images

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# ---- 邮件（SMTP 兜底，腾讯云 SES 失败时降级使用） ----
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- 腾讯云邮件推送（SES） ----
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_FROM_ADDRESS=no-reply@example.com
